# Used ONLY on the very first start (empty database) to create the admin account.
# If the password contains a $, wrap it in single quotes: ADMIN_PASSWORD='Pa$$word'
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=AStrongPassword!

# Production with HTTPS (docker-compose.prod.yml)
DOMAIN=itsm.your-domain.com
ACME_EMAIL=you@your-domain.com
